{
  "name": "easypanel",
  "version": "1.0.0",
  "description": "EasyPanel – the simple electrical panel designer. Offline visual editor for residential distribution boards.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "vite --open",
    "dev": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc && tsc -p scripts",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.9.0"
  }
}
