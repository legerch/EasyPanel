{
  "name": "easypanel",
  "version": "1.0.0",
  "description": "EasyPanel – the simple electrical panel designer. Offline visual editor for residential distribution boards.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite --open",
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.9.0"
  }
}
